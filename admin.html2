<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>Kawaii Market - JSON Primary Loader</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;700&family=M+PLUS+Rounded+1c:wght@500;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-cream: #FFF8E7;
            --main-red: #E63946;
            --main-blue: #1D3557;
            --accent-yellow: #FFB703;
            --mint-green: #2A9D8F;
            --purple-role: #7209B7;
            --shelf-wood: #D4A373;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            height: 100dvh;
            position: fixed;
            inset: 0;
            overflow: hidden;
            font-family: 'M PLUS Rounded 1c', 'Fredoka', sans-serif;
            background-color: var(--bg-cream);
            background-image: radial-gradient(#FAD2E1 2px, transparent 2px), radial-gradient(#BEE1E6 2px, var(--bg-cream) 2px);
            background-size: 30px 30px;
            display: flex;
            flex-direction: column;
        }

        #start-screen {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #1D3557 0%, #457B9D 100%);
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
            padding: 10px;
            overflow-y: auto;
        }

        .title-badge {
            background: var(--main-red);
            padding: 4px 16px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 800;
            border: 2px solid white;
            margin-bottom: 3px;
        }

        #start-screen h1 {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.9rem;
            margin: 3px 0;
            text-shadow: 2px 2px 0px var(--main-red);
        }

        .setup-section {
            background: rgba(255, 255, 255, 0.12);
            padding: 5px 10px;
            border-radius: 12px;
            margin: 3px 0;
            border: 2px dashed rgba(255,255,255,0.4);
            max-width: 580px;
            width: 100%;
        }

        .setup-title {
            font-size: 0.8rem;
            font-weight: 800;
            margin-bottom: 3px;
            color: var(--accent-yellow);
        }

        .options-row {
            display: flex;
            gap: 5px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .opt-btn {
            background: white;
            color: var(--main-blue);
            border: 2px solid #CBD5E1;
            padding: 4px 10px;
            border-radius: 8px;
            font-family: 'M PLUS Rounded 1c', sans-serif;
            font-weight: 800;
            font-size: 0.78rem;
            cursor: pointer;
        }

        .opt-btn.active {
            background: var(--accent-yellow);
            color: #78350F;
            border-color: white;
            box-shadow: 0 3px 0 #D97706;
        }

        .start-actions {
            display: flex;
            gap: 10px;
            margin-top: 8px;
        }

        .big-start-btn {
            background: var(--mint-green);
            color: white;
            border: 3px solid white;
            padding: 7px 24px;
            font-size: 1.05rem;
            font-weight: 800;
            border-radius: 20px;
            cursor: pointer;
            box-shadow: 0 4px 0 #1B635A;
        }

        .admin-open-btn {
            background: #7209B7;
            color: white;
            border: 3px solid white;
            padding: 7px 18px;
            font-size: 0.95rem;
            font-weight: 800;
            border-radius: 20px;
            cursor: pointer;
            box-shadow: 0 4px 0 #480CA8;
        }

        #admin-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(29, 53, 87, 0.92);
            z-index: 300;
            align-items: center;
            justify-content: center;
            padding: 10px;
        }

        .admin-card {
            background: white;
            width: 100%;
            max-width: 720px;
            border-radius: 16px;
            border: 4px solid var(--accent-yellow);
            padding: 12px;
            max-height: 94dvh;
            display: flex;
            flex-direction: column;
            color: var(--main-blue);
        }

        .admin-currency-bar {
            background: #EFF6FF;
            border: 2px solid #BFDBFE;
            border-radius: 10px;
            padding: 6px 10px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px;
        }

        .admin-tabs {
            display: flex;
            gap: 5px;
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .admin-tab-btn {
            flex: 1;
            padding: 5px;
            border-radius: 8px;
            border: 2px solid var(--main-blue);
            background: #F1F5F9;
            font-weight: 800;
            font-size: 0.78rem;
            cursor: pointer;
            color: var(--main-blue);
            white-space: nowrap;
        }

        .admin-tab-btn.active {
            background: var(--main-blue);
            color: white;
        }

        .admin-form-box {
            background: #F8FAFC;
            padding: 8px;
            border-radius: 10px;
            border: 2px solid #E2E8F0;
            margin-bottom: 8px;
        }

        .admin-form-row {
            display: flex;
            gap: 6px;
            margin-bottom: 5px;
            align-items: center;
            flex-wrap: wrap;
        }

        .admin-form-row input, .admin-form-row select, .dialog-textarea {
            padding: 5px 8px;
            border-radius: 6px;
            border: 2px solid #CBD5E1;
            font-family: 'M PLUS Rounded 1c', sans-serif;
            font-size: 0.8rem;
            font-weight: 700;
            user-select: text;
        }

        .dialog-textarea {
            width: 100%;
            min-height: 48px;
            resize: vertical;
            margin-bottom: 4px;
            font-family: 'Fredoka', sans-serif;
        }

        .admin-products-list {
            flex: 1;
            overflow-y: auto;
            max-height: 200px;
            border: 2px solid #E2E8F0;
            border-radius: 8px;
            padding: 4px;
        }

        .admin-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #F1F5F9;
            padding: 4px 8px;
            border-radius: 6px;
            margin-bottom: 4px;
            font-size: 0.8rem;
        }

        .admin-footer {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
            gap: 6px;
        }

        header {
            background: var(--main-blue);
            color: white;
            padding: 4px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 42px;
            flex-shrink: 0;
            box-shadow: 0 2px 5px rgba(0,0,0,0.15);
        }

        .header-info {
            display: flex;
            gap: 6px;
            align-items: center;
            font-size: 0.8rem;
            font-weight: 800;
        }

        .scores-container {
            display: flex;
            gap: 6px;
        }

        .score-pill {
            background: var(--main-red);
            padding: 2px 8px;
            border-radius: 10px;
            font-weight: 800;
            font-size: 0.8rem;
            border: 2px solid white;
        }
        .score-pill.p2 { background: var(--mint-green); }

        .btn-home {
            background: #EF4444;
            color: white;
            border: none;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 800;
            font-size: 0.75rem;
            cursor: pointer;
        }

        main {
            display: grid;
            grid-template-columns: 1.45fr 1fr;
            gap: 8px;
            padding: 6px 8px 8px 8px;
            flex: 1;
            min-height: 0;
            overflow: hidden;
        }

        .shelves-container {
            background: rgba(255, 255, 255, 0.92);
            border-radius: 14px;
            padding: 6px;
            border: 3px solid var(--shelf-wood);
            display: flex;
            flex-direction: column;
            min-height: 0;
            height: 100%;
            overflow: hidden;
        }

        .category-tabs {
            display: flex;
            gap: 3px;
            margin-bottom: 5px;
            flex-shrink: 0;
            overflow-x: auto;
        }

        .tab-btn {
            flex: 1;
            padding: 4px 4px;
            border-radius: 6px;
            border: 2px solid var(--main-blue);
            background: white;
            font-weight: 800;
            font-size: 0.7rem;
            cursor: pointer;
            color: var(--main-blue);
            white-space: nowrap;
        }

        .tab-btn.active {
            background: var(--main-blue);
            color: white;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 5px;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            flex: 1;
            min-height: 0;
            padding-right: 2px;
            align-content: start;
        }

        .product-card {
            background: white;
            border-radius: 10px;
            border: 2px solid #E2E8F0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4px 2px;
            cursor: pointer;
            position: relative;
            box-shadow: 0 2px 0 #E2E8F0;
            min-height: 75px;
        }

        .product-card:active {
            transform: scale(0.95);
            border-color: var(--accent-yellow);
        }

        .product-emoji { font-size: 1.5rem; line-height: 1; margin-bottom: 2px; }
        
        .product-name-en {
            font-family: 'Fredoka', sans-serif;
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--main-blue);
            text-align: center;
            line-height: 1.1;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        
        .product-price {
            background: var(--mint-green);
            color: white;
            padding: 1px 4px;
            border-radius: 6px;
            font-weight: 800;
            font-size: 0.7rem;
            margin-top: 2px;
        }
        .sound-icon { position: absolute; top: 2px; right: 3px; font-size: 0.55rem; opacity: 0.5; }

        .counter-area {
            display: flex;
            flex-direction: column;
            gap: 6px;
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .turn-banner {
            background: var(--purple-role);
            color: white;
            padding: 5px 10px;
            border-radius: 10px;
            font-weight: 800;
            font-size: 0.8rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 2px solid white;
            flex-shrink: 0;
        }

        .turn-banner.buyer-turn { background: #E63946; }
        .turn-banner.seller-turn { background: #2A9D8F; }

        .shopkeeper-box {
            background: white;
            border-radius: 12px;
            padding: 6px 8px;
            border: 3px solid var(--main-blue);
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .avatar {
            width: 42px;
            height: 42px;
            background: #FFE5EC;
            border-radius: 50%;
            border: 2px solid var(--main-red);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            flex-shrink: 0;
        }

        .speech-bubble { flex: 1; min-width: 0; }
        
        .speech-en {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.1rem;
            color: var(--main-blue);
            font-weight: 700;
            margin: 0 0 2px 0;
            line-height: 1.2;
        }
        
        .speech-jp-hint {
            font-size: 0.68rem; 
            color: #475569;
            margin: 0 0 4px 0;
            font-weight: 700;
        }

        .audio-controls-row {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
            align-items: center;
        }

        .listen-btn {
            background: #E0F2FE;
            color: #0369A1;
            border: 2px solid #0369A1;
            padding: 2px 7px;
            border-radius: 6px;
            font-weight: 800;
            font-size: 0.68rem;
            cursor: pointer;
        }

        .mic-btn {
            background: #FEE2E2;
            color: #B91C1C;
            border: 2px solid #DC2626;
            padding: 2px 7px;
            border-radius: 6px;
            font-weight: 800;
            font-size: 0.68rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .mic-btn.recording {
            background: #DC2626;
            color: white;
            animation: pulseMic 1s infinite;
        }

        @keyframes pulseMic {
            0% { transform: scale(1); }
            50% { transform: scale(1.06); }
            100% { transform: scale(1); }
        }

        .speech-result-box {
            margin-top: 4px;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 3px 6px;
            border-radius: 6px;
            background: #F8FAFC;
            border: 1px solid #CBD5E1;
            display: none;
        }

        .basket-box {
            background: white;
            border-radius: 12px;
            padding: 6px 8px;
            border: 3px solid var(--main-blue);
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }

        .basket-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 800;
            color: var(--main-blue);
            border-bottom: 2px dashed #CBD5E1;
            padding-bottom: 3px;
            flex-shrink: 0;
            font-size: 0.8rem;
        }

        .basket-items {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            padding: 4px 0;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            flex: 1;
            min-height: 0;
            align-content: start;
        }

        .basket-chip {
            background: #FEF3C7;
            border: 2px solid var(--accent-yellow);
            padding: 2px 6px;
            border-radius: 8px;
            font-family: 'Fredoka', sans-serif;
            font-weight: 700;
            font-size: 0.82rem;
            cursor: pointer;
        }

        .basket-actions {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
            padding-top: 3px;
        }

        .btn-clear {
            background: #F1F5F9;
            color: #475569;
            border: 2px solid #CBD5E1;
            padding: 6px 10px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 0.8rem;
            cursor: pointer;
        }

        .btn-main-action {
            flex: 1;
            background: var(--mint-green);
            color: white;
            border: none;
            padding: 7px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 0.9rem;
            cursor: pointer;
            box-shadow: 0 3px 0 #1E7167;
        }

        #payment-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(29, 53, 87, 0.88);
            z-index: 50;
            align-items: center;
            justify-content: center;
            padding: 6px;
        }

        .payment-card {
            background: var(--bg-cream);
            width: 100%;
            max-width: 680px;
            border-radius: 16px;
            border: 4px solid var(--accent-yellow);
            padding: 10px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            max-height: 94dvh;
            overflow-y: auto;
        }

        .modal-role-header {
            text-align: center;
            background: var(--main-blue);
            color: white;
            padding: 4px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }

        .payment-top {
            display: flex;
            justify-content: space-around;
            align-items: center;
            background: white;
            padding: 5px 10px;
            border-radius: 10px;
            margin-bottom: 5px;
            border: 2px solid var(--main-blue);
        }

        .money-display { text-align: center; }
        .money-label { font-size: 0.68rem; font-weight: 800; color: #64748B; }
        .money-value { font-family: 'Fredoka', sans-serif; font-size: 1.3rem; font-weight: 700; color: var(--main-red); }
        .money-value.paid { color: var(--mint-green); }

        .payment-speech-box {
            background: #F8FAFC;
            border: 2px solid #CBD5E1;
            border-radius: 10px;
            padding: 6px 10px;
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .wallet-section-title { font-weight: 800; color: var(--main-blue); margin: 3px 0; font-size: 0.75rem; }

        .notes-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 5px;
            margin-bottom: 5px;
        }

        .banknote {
            height: 34px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Fredoka', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: white;
            cursor: pointer;
            border: 2px solid rgba(255,255,255,0.6);
            box-shadow: 0 2px 0 rgba(0,0,0,0.2);
        }
        .banknote:active { transform: scale(0.95); }
        .note-5 { background: linear-gradient(135deg, #2A9D8F, #21867A); }
        .note-10 { background: linear-gradient(135deg, #E76F51, #D65A3C); }
        .note-20 { background: linear-gradient(135deg, #7209B7, #560BAD); }
        .note-50 { background: linear-gradient(135deg, #D62828, #B21E1E); }

        .coins-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 4px;
            margin-bottom: 6px;
        }

        .coin {
            aspect-ratio: 1;
            max-height: 40px;
            margin: 0 auto;
            width: 100%;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Fredoka', sans-serif;
            font-weight: 700;
            font-size: 0.78rem;
            cursor: pointer;
            box-shadow: 0 2px 0 rgba(0,0,0,0.25);
            border: 2px solid rgba(255,255,255,0.5);
        }
        .coin:active { transform: scale(0.92); }
        .coin-copper { background: #B87333; color: white; }
        .coin-silver { background: #CBD5E1; color: #1E293B; }
        .coin-gold { background: #FBBF24; color: #78350F; }

        .payment-footer { display: flex; gap: 8px; }
        .btn-pay-confirm {
            flex: 2;
            background: var(--main-red);
            color: white;
            border: none;
            padding: 7px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 3px 0 #9B2226;
        }
        .btn-pay-reset {
            flex: 1;
            background: #64748B;
            color: white;
            border: none;
            padding: 7px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 800;
            cursor: pointer;
        }

        #toast {
            position: fixed;
            top: 48px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--main-blue);
            color: white;
            padding: 6px 18px;
            border-radius: 50px;
            font-weight: 800;
            font-size: 0.9rem;
            border: 2px solid var(--accent-yellow);
            z-index: 200;
            display: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            text-align: center;
        }
    </style>
</head>
<body>

    <div id="start-screen">
        <div class="title-badge" id="app-badge-title">🇬🇧 スーパーマーケット英語ゲーム 🇯🇵</div>
        <h1>Kawaii English Mart</h1>
        <p style="font-size: 0.85rem; margin: 0 0 3px 0;" id="loading-msg">⏳ サーバーからデータを読み込んでいます...</p>

        <div class="setup-section">
            <div class="setup-title">👥 ゲームモード (Game Mode)</div>
            <div class="options-row">
                <button class="opt-btn active" id="mode-btn-1p" onclick="selectConfigMode('1p')">👤 1人 (交代)</button>
                <button class="opt-btn" id="mode-btn-2p" onclick="selectConfigMode('2p')">👫 2人 (対戦)</button>
            </div>
        </div>

        <div class="setup-section">
            <div class="setup-title">⭐ むずかしさ (Difficulty)</div>
            <div class="options-row">
                <button class="opt-btn active" id="diff-btn-easy" onclick="selectConfigDiff('easy')">Easy (かんたん)</button>
                <button class="opt-btn" id="diff-btn-med" onclick="selectConfigDiff('med')">Medium (ふつう)</button>
                <button class="opt-btn" id="diff-btn-hard" onclick="selectConfigDiff('hard')">Hard (むずかしい)</button>
            </div>
        </div>

        <div class="setup-section">
            <div class="setup-title">🗣️ 音声スピード (Speech Speed)</div>
            <div class="options-row">
                <button class="opt-btn" id="speed-btn-05" onclick="selectConfigSpeed(0.5)">0.5x</button>
                <button class="opt-btn" id="speed-btn-07" onclick="selectConfigSpeed(0.7)">0.7x</button>
                <button class="opt-btn active" id="speed-btn-09" onclick="selectConfigSpeed(0.9)">0.9x</button>
                <button class="opt-btn" id="speed-btn-12" onclick="selectConfigSpeed(1.2)">1.2x</button>
            </div>
        </div>

        <div class="start-actions">
            <button class="admin-open-btn" onclick="openAdminModal()">⚙️ 設定</button>
            <button class="big-start-btn" id="start-game-btn" onclick="launchGame()" disabled style="opacity: 0.5;">🚀 読み込み中...</button>
        </div>
    </div>

    <!-- MODAL ZAPLECZA (設定) -->
    <div id="admin-modal">
        <div class="admin-card">
            <!-- PRZENIESIONE USTAWIENIE WALUTY I AKCENTU -->
            <div class="admin-currency-bar">
                <span style="font-weight: 800; font-size: 0.82rem;">💱 Currency & Accent:</span>
                <div style="display: flex; gap: 5px;">
                    <button class="opt-btn active" id="curr-btn-gb" onclick="selectConfigCurrency('gb')">🇬🇧 イギリス (Pound £)</button>
                    <button class="opt-btn" id="curr-btn-us" onclick="selectConfigCurrency('us')">🇺🇸 アメリカ (Dollar $)</button>
                </div>
            </div>

            <div class="admin-tabs">
                <button class="admin-tab-btn active" id="tab-admin-products" onclick="switchAdminTab('products')">📦 商品</button>
                <button class="admin-tab-btn" id="tab-admin-dialogs" onclick="switchAdminTab('dialogs')">💬 セリフ</button>
                <button class="admin-tab-btn" id="tab-admin-export" onclick="switchAdminTab('export')">💾 JSON出力</button>
            </div>

            <div id="admin-section-products" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
                <div class="admin-form-box">
                    <div style="font-weight: 800; font-size: 0.8rem; margin-bottom: 4px;" id="admin-form-title">➕ 新しい商品を追加 / 編集</div>
                    <input type="hidden" id="edit-index" value="-1">
                    <div class="admin-form-row">
                        <input type="text" id="new-prod-name" placeholder="英語名 (例: apple)" style="flex: 2; min-width: 110px;">
                        <input type="text" id="new-prod-emoji" placeholder="🍎" style="width: 45px; text-align: center;">
                        <input type="text" id="new-prod-cat" placeholder="カテゴリ (例: food)" style="flex: 1.5; min-width: 100px;" list="cat-suggestions">
                        <datalist id="cat-suggestions">
                            <option value="food">
                            <option value="drinks">
                            <option value="bakery">
                            <option value="dessert">
                            <option value="fastfood">
                        </datalist>
                        <select id="new-prod-tier" style="width: 75px;">
                            <option value="easy">Easy</option>
                            <option value="med">Med</option>
                            <option value="hard">Hard</option>
                        </select>
                        <input type="number" id="new-prod-price" placeholder="価格" style="width: 75px;">
                    </div>
                    <div style="display: flex; gap: 5px;">
                        <button class="opt-btn active" id="save-prod-btn" onclick="saveProduct()" style="flex: 2; background: var(--mint-green); color: white;">+ 商品を追加する</button>
                        <button class="opt-btn" id="cancel-edit-btn" onclick="cancelEdit()" style="flex: 1; background: #94A3B8; color: white; display: none;">キャンセル</button>
                    </div>
                </div>

                <div class="admin-products-list" id="admin-products-container"></div>

                <div class="admin-footer">
                    <button class="opt-btn active" onclick="closeAdminModal()" style="background: var(--mint-green); color: white; flex: 1;">🎮 ゲームへ戻る</button>
                </div>
            </div>

            <div id="admin-section-dialogs" style="display: none; flex-direction: column; flex: 1; overflow-y: auto; padding-right: 4px;">
                <label style="font-size: 0.78rem; font-weight: 800;">🛒 商品1つの注文 (Easy):</label>
                <textarea id="dialog-1-input" class="dialog-textarea"></textarea>
                <label style="font-size: 0.78rem; font-weight: 800;">🛒 商品2つの注文 (Medium):</label>
                <textarea id="dialog-2-input" class="dialog-textarea"></textarea>
                <label style="font-size: 0.78rem; font-weight: 800;">🛒 商品3つの注文 (Hard):</label>
                <textarea id="dialog-3-input" class="dialog-textarea"></textarea>
                <label style="font-size: 0.78rem; font-weight: 800;">🛒 商品4つの注文 (Hard):</label>
                <textarea id="dialog-4-input" class="dialog-textarea"></textarea>

                <div class="admin-footer">
                    <button class="opt-btn active" onclick="saveCustomDialogsLocally()" style="background: var(--mint-green); color: white; flex: 1;">💾 変更を一時保存</button>
                    <button class="opt-btn" onclick="closeAdminModal()" style="background: #64748B; color: white;">閉じる</button>
                </div>
            </div>

            <div id="admin-section-export" style="display: none; flex-direction: column; flex: 1; overflow-y: auto; padding: 5px; gap: 10px;">
                <p style="font-size: 0.8rem; color: #334155; margin: 0;">GitHubの各JSONファイルを更新するためのデータをコピーします。</p>
                <button class="opt-btn active" onclick="copyJsonProducts()" style="background: var(--main-blue); color: white; width: 100%; padding: 8px;">📋 produkty.json をコピー</button>
                <button class="opt-btn active" onclick="copyJsonDialogs()" style="background: var(--main-blue); color: white; width: 100%; padding: 8px;">📋 dialogi.json をコピー</button>
                <button class="opt-btn active" onclick="copyJsonSettings()" style="background: var(--main-blue); color: white; width: 100%; padding: 8px;">📋 settings.json をコピー</button>
                <div class="admin-footer">
                    <button class="opt-btn active" onclick="closeAdminModal()" style="background: var(--mint-green); color: white; flex: 1;">🎮 ゲームへ戻る</button>
                </div>
            </div>
        </div>
    </div>

    <div id="toast"></div>

    <header>
        <div class="header-info">
            <button class="btn-home" onclick="returnToMenu()">🏠 メニュー</button>
            <span id="diff-badge-display">⭐ Easy</span>
        </div>
        <div class="scores-container">
            <div class="score-pill" id="score-box-1">⭐ P1: <span id="score1">0</span></div>
            <div class="score-pill p2" id="score-box-2" style="display: none;">🏪 P2: <span id="score2">0</span></div>
        </div>
    </header>

    <main>
        <section class="shelves-container">
            <div class="category-tabs" id="category-tabs-container">
                <button class="tab-btn active" onclick="filterCategory('all', this)">すべて (All)</button>
            </div>
            <div class="products-grid" id="products-grid"></div>
        </section>

        <section class="counter-area">
            <div class="turn-banner" id="turn-banner">
                <span id="turn-role-text">🛒 おきゃくさんのばん</span>
                <span id="round-info">Round 1</span>
            </div>

            <div class="shopkeeper-box">
                <div class="avatar" id="keeper-avatar">👩‍💼</div>
                <div class="speech-bubble">
                    <p class="speech-en" id="keeper-text-en">"Hello!"</p>
                    <p class="speech-jp-hint" id="keeper-text-jp">音声を聞いて英語を練習しよう！</p>
                    <div class="audio-controls-row">
                        <button class="listen-btn" onclick="repeatSpeech()">🔊 もういちど</button>
                        <button class="mic-btn" id="mic-record-btn" onclick="toggleStudentRecording('main')">🎤 発音チェック</button>
                    </div>
                    <div class="speech-result-box" id="speech-result-box"></div>
                </div>
            </div>

            <div class="basket-box">
                <div class="basket-header">
                    <span id="basket-title">🧺 かいものかご</span>
                    <span id="basket-total-wrapper">ごうけい: <strong id="basket-total-display" style="color: var(--main-red); font-size: 0.9rem;">0</strong></span>
                </div>

                <div class="basket-items" id="basket-items"></div>

                <div class="basket-actions">
                    <button class="btn-clear" onclick="clearBasket()">🗑️ けす</button>
                    <button class="btn-main-action" id="main-action-btn" onclick="handleMainAction()">次へ</button>
                </div>
            </div>
        </section>
    </main>

    <div id="payment-modal">
        <div class="payment-card">
            <div class="modal-role-header" id="modal-role-title">🛒 お金をはらおう！</div>

            <div class="payment-top">
                <div class="money-display">
                    <div class="money-label" id="pay-label-1">おかいけい</div>
                    <div class="money-value" id="pay-val-1">0</div>
                </div>
                <div style="font-size: 1.3rem;">➡️</div>
                <div class="money-display">
                    <div class="money-label" id="pay-label-2">だしたおかね</div>
                    <div class="money-value paid" id="pay-val-2">0</div>
                </div>
            </div>

            <div class="payment-speech-box">
                <div>
                    <p class="speech-en" id="modal-speech-en" style="font-size: 0.95rem; margin: 0;">"That will be..."</p>
                    <p class="speech-jp-hint" style="margin: 2px 0 0 0;">レジのセリフも発音練習</p>
                </div>
                <div style="display: flex; gap: 4px;">
                    <button class="listen-btn" onclick="speakModalPrompt()">🔊 きく</button>
                    <button class="mic-btn" id="mic-modal-btn" onclick="toggleStudentRecording('modal')">🎤 チェック</button>
                </div>
            </div>
            <div class="speech-result-box" id="modal-speech-result-box" style="margin-bottom: 6px;"></div>

            <div class="wallet-section-title" id="notes-title">💵 紙幣</div>
            <div class="notes-grid"></div>

            <div class="wallet-section-title" id="coins-title">🪙 硬貨</div>
            <div class="coins-grid" id="coins-grid-container"></div>

            <div class="payment-footer">
                <button class="btn-pay-reset" onclick="resetPayment()">やりなおす</button>
                <button class="btn-pay-confirm" id="modal-confirm-btn" onclick="confirmMoneyAction()">✨ はらう</button>
            </div>
        </div>
    </div>

    <script>
        let allProducts = [];
        let activeProducts = [];
        let selectedMode = '1p';
        let selectedDiff = 'easy';
        let selectedSpeed = 0.9;
        let selectedCurrency = 'gb';
        let currentCategoryFilter = 'all';
        let customDialogs = {};

        async function loadAllDataFromServer() {
            const timestamp = Date.now();
            try {
                const [prodRes, dialRes, settRes] = await Promise.all([
                    fetch(`produkty.json?t=${timestamp}`),
                    fetch(`dialogi.json?t=${timestamp}`),
                    fetch(`settings.json?t=${timestamp}`)
                ]);

                if (prodRes.ok) {
                    allProducts = await prodRes.json();
                } else {
                    throw new Error("Brak pliku produkty.json");
                }

                if (dialRes.ok) {
                    customDialogs = await dialRes.json();
                } else {
                    customDialogs = {
                        p1: ["Hi! Can I have {1}, please?"],
                        p2: ["Hi! Can I have {1} and {2}, please?"],
                        p3: ["Hi! Can I have {1}, {2}, and {3}, please?"],
                        p4: ["Hi! I need {1}, {2}, {3}, and {4}, please."],
                        payPrompt: "That will be {price}, please.",
                        changePrompt: "Here is {paid}. Please give me my change!",
                        start2p: "Hi! What would you like to buy today?"
                    };
                }

                if (settRes.ok) {
                    const settings = await settRes.json();
                    if (settings.currency) selectConfigCurrency(settings.currency);
                    if (settings.mode) selectConfigMode(settings.mode);
                    if (settings.difficulty) selectConfigDiff(settings.difficulty);
                    if (settings.speed) selectConfigSpeed(settings.speed);
                }

                document.getElementById('loading-msg').textContent = '✅ GitHubからすべてのデータを読み込みました！';
                enableStartButton();
            } catch (err) {
                console.error('Błąd ładowania JSON:', err);
                document.getElementById('loading-msg').textContent = '❌ データの読み込みに失敗しました (JSONを確認してください)';
            }
        }

        function enableStartButton() {
            const startBtn = document.getElementById('start-game-btn');
            startBtn.disabled = false;
            startBtn.style.opacity = '1';
            startBtn.textContent = '🚀 ゲームスタート！';
        }

        loadAllDataFromServer();

        function selectConfigMode(m) {
            selectedMode = m;
            ['1p', '2p'].forEach(mod => {
                document.getElementById(`mode-btn-${mod}`).classList.remove('active');
            });
            document.getElementById(`mode-btn-${m}`).classList.add('active');
        }

        function selectConfigCurrency(c) {
            selectedCurrency = c;
            ['gb', 'us'].forEach(curr => {
                document.getElementById(`curr-btn-${curr}`).classList.remove('active');
            });
            document.getElementById(`curr-btn-${c}`).classList.add('active');

            if (c === 'gb') {
                document.getElementById('app-badge-title').textContent = "🇬🇧 イギリススーパーマーケット英語ゲーム 🇯🇵";
            } else {
                document.getElementById('app-badge-title').textContent = "🇺🇸 アメリカスーパーマーケット英語ゲーム 🇯🇵";
            }
            loadEnglishVoice();
        }

        function selectConfigDiff(d) {
            selectedDiff = d;
            ['easy', 'med', 'hard'].forEach(diff => {
                document.getElementById(`diff-btn-${diff}`).classList.remove('active');
            });
            document.getElementById(`diff-btn-${d}`).classList.add('active');
        }

        function selectConfigSpeed(spd) {
            selectedSpeed = spd;
            [0.5, 0.7, 0.9, 1.2].forEach(s => {
                const idMap = { 0.5: '05', 0.7: '07', 0.9: '09', 1.2: '12' };
                document.getElementById(`speed-btn-${idMap[s]}`).classList.remove('active');
            });
            const activeIdMap = { 0.5: '05', 0.7: '07', 0.9: '09', 1.2: '12' };
            document.getElementById(`speed-btn-${activeIdMap[spd]}`).classList.add('active');
        }

        function returnToMenu() {
            document.getElementById('start-screen').style.display = 'flex';
        }

        function openAdminModal() {
            cancelEdit();
            renderAdminList();
            loadDialogInputs();
            switchAdminTab('products');
            document.getElementById('admin-modal').style.display = 'flex';
        }

        function switchAdminTab(tab) {
            ['products', 'dialogs', 'export'].forEach(t => {
                document.getElementById(`tab-admin-${t}`).classList.toggle('active', t === tab);
                document.getElementById(`admin-section-${t}`).style.display = t === tab ? 'flex' : 'none';
            });
        }

        function loadDialogInputs() {
            document.getElementById('dialog-1-input').value = (customDialogs.p1 || []).join('\n');
            document.getElementById('dialog-2-input').value = (customDialogs.p2 || []).join('\n');
            document.getElementById('dialog-3-input').value = (customDialogs.p3 || []).join('\n');
            document.getElementById('dialog-4-input').value = (customDialogs.p4 || []).join('\n');
        }

        function saveCustomDialogsLocally() {
            const parseLines = (id) => document.getElementById(id).value.split('\n').map(l => l.trim()).filter(l => l.length > 0);
            customDialogs.p1 = parseLines('dialog-1-input');
            customDialogs.p2 = parseLines('dialog-2-input');
            customDialogs.p3 = parseLines('dialog-3-input');
            customDialogs.p4 = parseLines('dialog-4-input');
            showToast("💬 一時保存しました (JSONを出力してファイルを更新してください)");
        }

        function copyJsonProducts() {
            navigator.clipboard.writeText(JSON.stringify(allProducts, null, 4)).then(() => alert("✅ produkty.json をコピーしました"));
        }

        function copyJsonDialogs() {
            navigator.clipboard.writeText(JSON.stringify(customDialogs, null, 4)).then(() => alert("✅ dialogi.json をコピーしました"));
        }

        function copyJsonSettings() {
            const settings = { currency: selectedCurrency, mode: selectedMode, difficulty: selectedDiff, speed: selectedSpeed };
            navigator.clipboard.writeText(JSON.stringify(settings, null, 4)).then(() => alert("✅ settings.json をコピーしました"));
        }

        function closeAdminModal() {
            document.getElementById('admin-modal').style.display = 'none';
        }

        function renderAdminList() {
            const container = document.getElementById('admin-products-container');
            container.innerHTML = '';
            allProducts.forEach((prod, index) => {
                const row = document.createElement('div');
                row.className = 'admin-item-row';
                row.innerHTML = `
                    <span>${prod.emoji} <strong>${prod.name}</strong> (${prod.cat}, ${prod.tier}, ${prod.price})</span>
                    <div style="display: flex; gap: 4px; align-items: center;">
                        <button class="opt-btn" onclick="startEditProduct(${index})" style="background: #3B82F6; color: white; padding: 2px 6px;">✏️ 編集</button>
                        <button class="opt-btn" onclick="deleteProduct(${index})" style="background: #EF4444; color: white; padding: 2px 6px;">🗑️</button>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        function startEditProduct(index) {
            const prod = allProducts[index];
            document.getElementById('edit-index').value = index;
            document.getElementById('new-prod-name').value = prod.name;
            document.getElementById('new-prod-emoji').value = prod.emoji;
            document.getElementById('new-prod-cat').value = prod.cat;
            document.getElementById('new-prod-tier').value = prod.tier;
            document.getElementById('new-prod-price').value = prod.price;
            document.getElementById('admin-form-title').textContent = "✏️ 商品の編集";
            document.getElementById('save-prod-btn').textContent = "💾 保存";
            document.getElementById('cancel-edit-btn').style.display = 'block';
        }

        function cancelEdit() {
            document.getElementById('edit-index').value = "-1";
            document.getElementById('new-prod-name').value = '';
            document.getElementById('new-prod-emoji').value = '';
            document.getElementById('new-prod-cat').value = '';
            document.getElementById('new-prod-price').value = '';
            document.getElementById('admin-form-title').textContent = "➕ 新しい商品を追加";
            document.getElementById('save-prod-btn').textContent = "+ 追加";
            document.getElementById('cancel-edit-btn').style.display = 'none';
        }

        function saveProduct() {
            const editIdx = parseInt(document.getElementById('edit-index').value);
            const name = document.getElementById('new-prod-name').value.trim().toLowerCase();
            const emoji = document.getElementById('new-prod-emoji').value.trim() || '📦';
            const cat = document.getElementById('new-prod-cat').value.trim().toLowerCase() || 'general';
            const tier = document.getElementById('new-prod-tier').value;
            const price = parseInt(document.getElementById('new-prod-price').value);

            if (!name || isNaN(price) || price <= 0) {
                alert("正しい情報を入力してください");
                return;
            }

            if (editIdx === -1) {
                allProducts.push({ id: name.replace(/\s+/g, '_'), name, price, emoji, cat, tier });
            } else {
                allProducts[editIdx] = { id: allProducts[editIdx].id, name, price, emoji, cat, tier };
                cancelEdit();
            }
            renderAdminList();
            showToast("✨ リストを更新しました (JSON出力タブからコピーしてください)");
        }

        function deleteProduct(index) {
            allProducts.splice(index, 1);
            renderAdminList();
            showToast("🗑️ 削除しました");
        }

        function getArticle(word) {
            return ['a', 'e', 'i', 'o', 'u'].includes(word.charAt(0).toLowerCase()) ? 'an' : 'a';
        }

        function formatDialogTemplate(template, names) {
            let result = template;
            names.forEach((name, idx) => {
                result = result.replace(`{${idx + 1}}`, `${getArticle(name)} ${name}`);
            });
            return result;
        }

        let roundNumber = 1;
        let turnPhase = '1p_buyer';
        let paymentPhase = 'buyer_pays';
        let basket = [];
        let targetOrder = [];
        let lastSpokenText = "";
        let lastModalSpokenText = "";
        let targetBillUnits = 0;
        let buyerPaidUnits = 0;
        let expectedChangeUnits = 0;
        let currentInputMoney = 0;
        let score1 = 0;
        let score2 = 0;
        let englishVoice = null;

        function loadEnglishVoice() {
            const voices = window.speechSynthesis.getVoices();
            if (!voices.length) return;
            const targetLang = selectedCurrency === 'gb' ? 'en-GB' : 'en-US';
            const langVoices = voices.filter(v => v.lang.startsWith(targetLang) || v.lang.startsWith('en'));
            englishVoice = langVoices.find(v => v.name.includes('Natural') || v.name.includes('Siri') || v.name.includes('Samantha')) || langVoices[0] || voices[0];
        }

        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = loadEnglishVoice;
            loadEnglishVoice();
        }

        function speakEnglish(text) {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(text.replace(/!/g, '.'));
            u.lang = selectedCurrency === 'gb' ? 'en-GB' : 'en-US';
            if (englishVoice) u.voice = englishVoice;
            u.rate = selectedSpeed;
            u.pitch = 1.03;
            window.speechSynthesis.speak(u);
        }

        function toggleStudentRecording(context) {
            const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRec) {
                alert("このブラウザは音声認識に対応していません");
                return;
            }

            const btnId = context === 'main' ? 'mic-record-btn' : 'mic-modal-btn';
            const resBoxId = context === 'main' ? 'speech-result-box' : 'modal-speech-result-box';
            const targetText = context === 'main' ? lastSpokenText : lastModalSpokenText;
            const micBtn = document.getElementById(btnId);
            const resBox = document.getElementById(resBoxId);

            const recognition = new SpeechRec();
            recognition.lang = selectedCurrency === 'gb' ? 'en-GB' : 'en-US';

            recognition.onstart = () => {
                micBtn.classList.add('recording');
                micBtn.textContent = "🛑 聞き取り中...";
                resBox.style.display = 'block';
                resBox.textContent = "🎤 話してください...";
            };

            recognition.onresult = (event) => {
                const spoken = event.results[0][0].transcript;
                evaluatePronunciation(spoken, targetText, resBoxId);
            };

            recognition.onerror = () => {
                resBox.textContent = "❌ エラーが発生しました";
            };

            recognition.onend = () => {
                micBtn.classList.remove('recording');
                micBtn.textContent = context === 'main' ? "🎤 発音チェック" : "🎤 チェック";
            };

            recognition.start();
        }

        function evaluatePronunciation(spoken, target, resBoxId) {
            const resBox = document.getElementById(resBoxId);
            const clean = str => str.toLowerCase().replace(/[.,!?'"-]/g, '').trim();
            const spokenWords = clean(spoken).split(/\s+/);
            const targetWords = clean(target).split(/\s+/);

            let matches = 0;
            targetWords.forEach(w => { if (spokenWords.includes(w)) matches++; });
            const accuracy = Math.round((matches / targetWords.length) * 100);

            resBox.style.display = 'block';
            if (accuracy >= 80) {
                resBox.style.color = '#15803D';
                resBox.innerHTML = `🎉 すばらしい！ (${accuracy}%)`;
                score1 += 2;
                updateScoreDisplay();
            } else {
                resBox.style.color = '#B91C1C';
                resBox.innerHTML = `💪 もういちど！ (${accuracy}%)`;
            }
        }

        function formatCurrency(units) {
            if (selectedCurrency === 'gb') {
                return units < 100 ? `${units}p` : `£${(units / 100).toFixed(2)}`;
            } else {
                return units < 100 ? `${units}¢` : `$${(units / 100).toFixed(2)}`;
            }
        }

        function priceToEnglishSpeech(units) {
            if (units === 0) return selectedCurrency === 'gb' ? "zero pence" : "zero cents";
            const mainUnit = Math.floor(units / 100);
            const subUnit = units % 100;
            const mainName = selectedCurrency === 'gb' ? (mainUnit === 1 ? "one pound" : `${mainUnit} pounds`) : (mainUnit === 1 ? "one dollar" : `${mainUnit} dollars`);
            const subName = selectedCurrency === 'gb' ? "pence" : "cents";
            if (mainUnit === 0) return `${subUnit} ${subName}`;
            if (subUnit === 0) return mainName;
            return `${mainName} ${subUnit}`;
        }

        function setupWalletInterface() {
            const notesContainer = document.querySelector('.notes-grid');
            const coinsContainer = document.getElementById('coins-grid-container');

            if (selectedCurrency === 'gb') {
                document.getElementById('notes-title').textContent = "💵 紙幣 (Pounds)";
                notesContainer.innerHTML = `
                    <div class="banknote note-5" onclick="addMoney(500)">£5</div>
                    <div class="banknote note-10" onclick="addMoney(1000)">£10</div>
                    <div class="banknote note-20" onclick="addMoney(2000)">£20</div>
                    <div class="banknote note-50" onclick="addMoney(5000)">£50</div>
                `;
                document.getElementById('coins-title').textContent = "🪙 硬貨";
                coinsContainer.innerHTML = `
                    <div class="coin coin-copper" onclick="addMoney(1)">1p</div>
                    <div class="coin coin-copper" onclick="addMoney(2)">2p</div>
                    <div class="coin coin-silver" onclick="addMoney(5)">5p</div>
                    <div class="coin coin-silver" onclick="addMoney(10)">10p</div>
                    <div class="coin coin-silver" onclick="addMoney(20)">20p</div>
                    <div class="coin coin-silver" onclick="addMoney(50)">50p</div>
                    <div class="coin coin-gold" onclick="addMoney(100)">£1</div>
                    <div class="coin coin-gold" onclick="addMoney(200)">£2</div>
                `;
            } else {
                document.getElementById('notes-title').textContent = "💵 紙幣 (Dollars)";
                notesContainer.innerHTML = `
                    <div class="banknote note-5" onclick="addMoney(100)">$1</div>
                    <div class="banknote note-10" onclick="addMoney(500)">$5</div>
                    <div class="banknote note-20" onclick="addMoney(1000)">$10</div>
                    <div class="banknote note-50" onclick="addMoney(2000)">$20</div>
                `;
                document.getElementById('coins-title').textContent = "🪙 硬貨";
                coinsContainer.innerHTML = `
                    <div class="coin coin-copper" onclick="addMoney(1)">1¢</div>
                    <div class="coin coin-copper" onclick="addMoney(5)">5¢</div>
                    <div class="coin coin-silver" onclick="addMoney(10)">10¢</div>
                    <div class="coin coin-silver" onclick="addMoney(25)">25¢</div>
                    <div class="coin coin-gold" onclick="addMoney(50)">50¢</div>
                    <div class="coin coin-gold" onclick="addMoney(100)">$1</div>
                `;
            }
        }

        function launchGame() {
            document.getElementById('start-screen').style.display = 'none';
            loadEnglishVoice();
            setupWalletInterface();

            if (selectedDiff === 'easy') {
                activeProducts = allProducts.filter(p => p.tier === 'easy');
            } else if (selectedDiff === 'med') {
                activeProducts = allProducts.filter(p => p.tier === 'easy' || p.tier === 'med');
            } else {
                activeProducts = [...allProducts];
            }
            if(activeProducts.length === 0) activeProducts = [...allProducts];

            buildCategoryTabs();
            renderProducts('all');
            roundNumber = 1;
            score1 = 0;
            score2 = 0;
            updateScoreDisplay();
            setupNextRound();
        }

        function buildCategoryTabs() {
            const tabsContainer = document.getElementById('category-tabs-container');
            tabsContainer.innerHTML = `<button class="tab-btn active" onclick="filterCategory('all', this)">すべて (All)</button>`;
            const categories = [...new Set(activeProducts.map(p => p.cat))];
            const catNamesJp = { 'food': '🍎 食品', 'drinks': '🧃 飲み物', 'bakery': '🥐 パン', 'dessert': '🍰 デザート', 'fastfood': '🍔 バーガー' };

            categories.forEach(cat => {
                const btn = document.createElement('button');
                btn.className = 'tab-btn';
                btn.textContent = catNamesJp[cat] || cat;
                btn.onclick = (e) => filterCategory(cat, e.currentTarget);
                tabsContainer.appendChild(btn);
            });
            currentCategoryFilter = 'all';
        }

        function updateScoreDisplay() {
            document.getElementById('score1').textContent = score1;
            if(document.getElementById('score2')) document.getElementById('score2').textContent = score2;
        }

        function generateRandomOrder() {
            const count = selectedDiff === 'easy' ? 1 : (selectedDiff === 'med' ? 2 : (Math.random() > 0.5 ? 3 : 4));
            const shuffled = [...activeProducts].sort(() => 0.5 - Math.random());
            targetOrder = shuffled.slice(0, Math.min(count, shuffled.length));
            const names = targetOrder.map(i => i.name);
            let pool = customDialogs.p1;
            if (targetOrder.length === 2) pool = customDialogs.p2;
            else if (targetOrder.length === 3) pool = customDialogs.p3;
            else if (targetOrder.length >= 4) pool = customDialogs.p4;

            lastSpokenText = formatDialogTemplate(pool[Math.floor(Math.random() * pool.length)], names);
        }

        function setupNextRound() {
            basket = [];
            updateBasketUI();
            document.getElementById('speech-result-box').style.display = 'none';
            document.getElementById('round-info').textContent = `Round ${roundNumber}`;
            const banner = document.getElementById('turn-banner');
            const roleText = document.getElementById('turn-role-text');
            const mainBtn = document.getElementById('main-action-btn');

            if (selectedMode === '1p') {
                if (roundNumber % 2 === 1) {
                    turnPhase = '1p_buyer';
                    banner.className = 'turn-banner buyer-turn';
                    roleText.textContent = '🛒 あなたの役: おきゃくさん';
                    document.getElementById('keeper-avatar').textContent = '👩‍💼';
                    generateRandomOrder();
                    document.getElementById('keeper-text-en').textContent = `"${lastSpokenText}"`;
                    mainBtn.textContent = "💷 おかいけいへ";
                    setTimeout(() => speakEnglish(lastSpokenText), 300);
                } else {
                    turnPhase = '1p_seller_pick';
                    banner.className = 'turn-banner seller-turn';
                    roleText.textContent = '🛒 あなたの役: てんいんさん';
                    document.getElementById('keeper-avatar').textContent = '🧒';
                    generateRandomOrder();
                    document.getElementById('keeper-text-en').textContent = `"${lastSpokenText}"`;
                    mainBtn.textContent = "📦 商品をわたす";
                    setTimeout(() => speakEnglish(lastSpokenText), 300);
                }
            } else {
                turnPhase = '2p_buyer_pick';
                banner.className = 'turn-banner buyer-turn';
                roleText.textContent = '🛒 P1: 商品を選ぼう！';
                lastSpokenText = customDialogs.start2p || "Hi! What would you like to buy today?";
                document.getElementById('keeper-text-en').textContent = `"${lastSpokenText}"`;
                mainBtn.textContent = "🗣️ ちゅうもんする";
                setTimeout(() => speakEnglish(lastSpokenText), 300);
            }
        }

        function renderProducts(category) {
            currentCategoryFilter = category;
            const grid = document.getElementById('products-grid');
            grid.innerHTML = '';
            (category === 'all' ? activeProducts : activeProducts.filter(p => p.cat === category)).forEach(prod => {
                const card = document.createElement('div');
                card.className = 'product-card';
                card.innerHTML = `
                    <span class="sound-icon">🔊</span>
                    <div class="product-emoji">${prod.emoji}</div>
                    <div class="product-name-en">${prod.name}</div>
                    <div class="product-price">${formatCurrency(prod.price)}</div>
                `;
                card.onclick = () => handleProductClick(prod);
                grid.appendChild(card);
            });
        }

        function filterCategory(cat, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderProducts(cat);
        }

        function handleProductClick(prod) {
            speakEnglish(prod.name);
            basket.push(prod);
            updateBasketUI();
        }

        function updateBasketUI() {
            const container = document.getElementById('basket-items');
            const totalDisplay = document.getElementById('basket-total-display');
            if (basket.length === 0) {
                container.innerHTML = '<span style="color: #94A3B8; font-size: 0.78rem;">商品をタッチしてね！</span>';
                totalDisplay.textContent = formatCurrency(0);
                return;
            }
            container.innerHTML = '';
            let total = 0;
            basket.forEach((item, idx) => {
                total += item.price;
                const chip = document.createElement('div');
                chip.className = 'basket-chip';
                chip.innerHTML = `${item.emoji} ${item.name} ✕`;
                chip.onclick = () => { basket.splice(idx, 1); updateBasketUI(); };
                container.appendChild(chip);
            });
            totalDisplay.textContent = formatCurrency(total);
        }

        function clearBasket() { basket = []; updateBasketUI(); }
        function repeatSpeech() { if (lastSpokenText) speakEnglish(lastSpokenText); }

        function handleMainAction() {
            if (basket.length === 0) { showToast("⚠️ 商品を選んでね！"); return; }
            if (turnPhase === '2p_buyer_pick') {
                targetOrder = [...basket];
                basket = [];
                updateBasketUI();
                turnPhase = '2p_seller_pick';
                generateRandomOrder();
                document.getElementById('keeper-text-en').textContent = `"${lastSpokenText}"`;
                speakEnglish(lastSpokenText);
                return;
            }

            const isMatch = targetOrder.map(i => i.id).sort().join() === basket.map(i => i.id).sort().join();
            targetBillUnits = targetOrder.reduce((sum, item) => sum + item.price, 0);

            if (!isMatch) {
                speakEnglish("Wrong items!");
                showToast("❌ 商品がちがいます！");
                setTimeout(() => { roundNumber++; setupNextRound(); }, 2500);
                return;
            }

            if (turnPhase === '1p_buyer') openPaymentModal('buyer_pays');
            else {
                score1 += 5;
                updateScoreDisplay();
                const possibleNotes = selectedCurrency === 'gb' ? [500, 1000, 2000, 5000] : [100, 500, 1000, 2000];
                const validNotes = possibleNotes.filter(n => n >= targetBillUnits);
                buyerPaidUnits = validNotes[Math.floor(Math.random() * validNotes.length)] || possibleNotes[possibleNotes.length - 1];
                expectedChangeUnits = buyerPaidUnits - targetBillUnits;
                setTimeout(() => openPaymentModal('seller_gives_change'), 1200);
            }
        }

        function openPaymentModal(phase) {
            paymentPhase = phase;
            currentInputMoney = 0;
            document.getElementById('payment-modal').style.display = 'flex';
            document.getElementById('modal-speech-result-box').style.display = 'none';

            if (phase === 'buyer_pays') {
                document.getElementById('pay-val-1').textContent = formatCurrency(targetBillUnits);
                document.getElementById('pay-val-2').textContent = formatCurrency(0);
                lastModalSpokenText = (customDialogs.payPrompt || "That will be {price}, please.").replace('{price}', priceToEnglishSpeech(targetBillUnits));
            } else {
                document.getElementById('pay-val-1').textContent = formatCurrency(buyerPaidUnits);
                document.getElementById('pay-val-2').textContent = formatCurrency(0);
                lastModalSpokenText = (customDialogs.changePrompt || "Here is {paid}. Please give me my change!").replace('{paid}', priceToEnglishSpeech(buyerPaidUnits));
            }
            document.getElementById('modal-speech-en').textContent = `"${lastModalSpokenText}"`;
            speakEnglish(lastModalSpokenText);
        }

        function speakModalPrompt() { if (lastModalSpokenText) speakEnglish(lastModalSpokenText); }
        function addMoney(units) { currentInputMoney += units; document.getElementById('pay-val-2').textContent = formatCurrency(currentInputMoney); speakEnglish(priceToEnglishSpeech(units)); }
        function resetPayment() { currentInputMoney = 0; document.getElementById('pay-val-2').textContent = formatCurrency(0); }

        function confirmMoneyAction() {
            document.getElementById('payment-modal').style.display = 'none';
            score1 += 10;
            updateScoreDisplay();
            showToast("🎉 せいかい (+10pt)");
            setTimeout(() => { roundNumber++; setupNextRound(); }, 2500);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 2500);
        }
    </script>
</body>
</html>
